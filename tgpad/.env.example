# Copy to .env and fill in: cp .env.example .env && chmod 600 .env
# .env is gitignored. Never commit the real one.

# From @BotFather: a SEPARATE bot from the $SDOGE buy bot.
TELEGRAM_BOT_TOKEN=

# Every user wallet is derived from this secret. Anyone who has it controls
# every user's funds, and losing it loses access to all of them. Back it up
# offline. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_MASTER_SECRET=

# Comma-separated numeric Telegram user IDs allowed to run /hide, /ban, /review, etc.
# (Ask @userinfobot for yours.)
ADMIN_TELEGRAM_IDS=

# Image and name moderation (Venice vision). Without it, every launch is held
# for admin review before anything about it is shown publicly.
VENICE_API_KEY=

# Channel where approved launches get announced, e.g. -1001234567890.
# The bot must be an admin there, with post, edit and delete rights.
LAUNCHES_CHANNEL_ID=

# Set these once the launchpad contracts are deployed. They override config.json.
FACTORY_ADDRESS=
HOOK_ADDRESS=
ROUTER_ADDRESS=

# Optional RPC overrides.
# ARC_RPC_URL=
