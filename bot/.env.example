# Copy this to .env and fill in real values: cp .env.example .env
# .env is gitignored - never commit your real one.

# Required - the only thing that can't live in the committed config.json.
# From @BotFather. Already created for this project: @Stabledogebbot
TELEGRAM_BOT_TOKEN=

# Optional. A paid RPC URL (e.g. Alchemy) has its API key baked into the
# URL itself, so like the bot token it's a real credential and belongs
# here, not in config.json. Only used if both free Arc RPC endpoints fail.
# ARC_RPC_FALLBACK_URL=

# Optional overrides - everything below already has a working default
# (see config.json and buy-bot.js's header comment for the full list).
# POLL_INTERVAL_MS=25000
# DRY_RUN=false
