# Copy to .env.local (or set these in Vercel), fill in real values, never
# commit .env.local.

# Arc mainnet's public RPC works but is rate-limited (~20 calls/s per IP).
# For real traffic use your own endpoint, e.g. an Alchemy Arc URL with a
# domain allowlist. It ships in the site bundle, so treat it as public.
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.arc.io
# 5042 = Arc mainnet, 5042002 = Arc testnet. Must match NEXT_PUBLIC_RPC_URL's
# actual network, or wagmi will connect to the wrong chain.
NEXT_PUBLIC_CHAIN_ID=5042
NEXT_PUBLIC_CHAIN_NAME=Arc
NEXT_PUBLIC_EXPLORER_URL=https://explorer.arc.io

# SDOGE Pad on Arc mainnet (pad/deployments/arc-mainnet.json).
# The site refuses to build without them.
NEXT_PUBLIC_PORTAL=0x7F80b1198e6DAa56b0019Cb45020382358E385Fd
NEXT_PUBLIC_HOOK=0x10dE365Cc583bA953a9e6C36658A138082d9e8cc
# The block the portal was deployed at. Launch scans start here.
NEXT_PUBLIC_PORTAL_GENESIS_BLOCK=22720736
# The pad admin wallet, shown on the unlinked /admin page (where it switches
# the launchpad on).
NEXT_PUBLIC_PAD_ADMIN=0x5899a0576A94327a6316E01190f951edf7645914

# Arc's shared infrastructure, the same on mainnet and testnet. These are
# also the built-in defaults.
NEXT_PUBLIC_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
NEXT_PUBLIC_ROUTER=0x4fcA4a51Ab4F23A7447b3284fBd7D73289A89Fb1
NEXT_PUBLIC_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
NEXT_PUBLIC_USDC=0x3600000000000000000000000000000000000000

# FALSE, not true: SdogePadHook/SdogePadPortal revert if quoteAsset is
# address(0). The quote leg of every swap is the USDC ERC-20 above, always
# via approve/Permit2, never msg.value.
NEXT_PUBLIC_QUOTE_IS_NATIVE=false
NEXT_PUBLIC_QUOTE_DECIMALS=6

NEXT_PUBLIC_BRAND=SDOGE Launchpad
NEXT_PUBLIC_TAGLINE=Ideas today. A more stable tomorrow.
# Market cap the progress bars on launch cards fill toward.
NEXT_PUBLIC_MILESTONE_USD=30000
# Optional: the main Stable Doge site, shown as "Home" in the nav.
NEXT_PUBLIC_HOME_URL=
# $SDOGE, pinned first in Featured Launches with live DexScreener numbers.
NEXT_PUBLIC_SDOGE_TOKEN=0xf8df98fda14cabb2e8b6efe920081ffcbb0bb405
# Optional: this site's public URL, so social previews get absolute image
# links.
NEXT_PUBLIC_SITE_URL=https://pad.stabledoge.site

# Optional. Point this at a deployed pad-indexer (see ../pad-indexer/README.md)
# to get real 24h volume/trades/holders/candles. Leave blank and those fields
# show as unknown ("—") rather than a made-up number; price and market cap
# always come straight from the chain.
NEXT_PUBLIC_INDEXER_URL=

# Needed for phone wallets: without it only browser-extension wallets can
# connect. Free: create a project at https://cloud.reown.com and paste its
# Project ID. Add the site's domain to that project's allowlist.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server-only. Token info (description, image, links) and a snapshot of the
# launch list live in this site's own private Vercel Blob store. Vercel sets
# this when the store is connected to the project. Without it the site still
# works: the launch list is read straight from the chain (slower on a cold
# start) and token details can't be saved.
BLOB_READ_WRITE_TOKEN=
