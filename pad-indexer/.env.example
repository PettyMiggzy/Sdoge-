# Copy to .env, fill in real values, never commit .env.

RPC_URL=https://rpc.mainnet.arc.io
PORT=8787
DB_PATH=./data/index.db

# The live SDOGE Pad deployment on Arc mainnet (pad/deployments/arc-mainnet.json).
PORTAL=0x7F80b1198e6DAa56b0019Cb45020382358E385Fd
HOOK=0x10dE365Cc583bA953a9e6C36658A138082d9e8cc
POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
QUOTE=0x3600000000000000000000000000000000000000

# Quote (USDC predeploy) amounts inside Swap events are 6-decimal at the
# ERC-20/pool-accounting level, even though a wallet's native balance for the
# same USDC is 18-decimal. The indexer only ever reads the 6-decimal one.
QUOTE_DECIMALS=6
TOKEN_DECIMALS=18

# The block the portal was deployed at; saves a full-chain scan on first run.
START_BLOCK=22720736
# getLogs range per request; lower it if the RPC answers 429.
CHUNK_BLOCKS=2000
POLL_MS=4000
