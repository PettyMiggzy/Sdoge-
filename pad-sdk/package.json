{
  "name": "sdoge-pad-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for SDOGE Pad on Arc: find launches the moment they happen, quote, buy, sell, launch and claim.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "watch-launches": "node examples/watch-launches.mjs",
    "buy-new-launches": "node examples/buy-new-launches.mjs",
    "market": "node examples/market-api.mjs"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "typescript": "5.6.2",
    "viem": "2.21.19"
  }
}
