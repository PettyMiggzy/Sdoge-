# Optional settings for script/DeploySdogePad.s.sol. See README.md.
#
# Never put a private key here. Forge loads pad/.env automatically on every
# `forge script` run, so a key in this file sits next to anything forge
# executes. Sign with an encrypted keystore instead:
#   cast wallet import sdogepad-deployer --interactive
#   forge script ... --account sdogepad-deployer --sender <deployer address>

# Owns SdogePadTreasury, which collects the platform's 10% of every launch.
# Defaults to the deployer.
TREASURY_OWNER=0x5899a0576A94327a6316E01190f951edf7645914

# The hook's admin (bootstrapper): switches the main portal on and decides
# the white-label factory slot. Permanent. Defaults to TREASURY_OWNER. When
# it isn't the deployer, the pad deploys switched off and this wallet sends
# one transaction (bootstrapMainPortal) to switch it on.
PAD_ADMIN=0x5899a0576A94327a6316E01190f951edf7645914

# What to do with the hook's one-shot white-label factory slot (only when
# PAD_ADMIN is the deployer): 2 = leave it open (default),
# 1 = deploy the factory now, 0 = renounce it forever.
WHITE_LABEL=2

# White-label setup fee in raw USDC units (100000000 = $100). Used only
# when WHITE_LABEL=1, or by script/DeployPadFactory.s.sol.
PAD_SETUP_FEE=100000000
